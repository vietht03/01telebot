BOT_TOKEN=dán_token_từ_BotFather_vào_đây
# ID Telegram của bạn (admin) - nhận báo cáo người chưa điểm danh. Lấy bằng cách chat /myid với bot
ADMIN_ID=0
# ID nhóm điểm danh (số âm). Thêm bot vào nhóm rồi gõ /groupid
GROUP_ID=0
# Giờ gửi form điểm danh (HH:MM, 24h), nhiều giờ cách nhau bằng dấu phẩy
CHECKIN_TIMES=08:00
# Sau bao nhiêu phút thì báo cáo người chưa điểm danh cho admin
DEADLINE_MINUTES=15
# Chỉ gửi vào các thứ này (0=T2 ... 6=CN)
DAYS=0,1,2,3,4
TIMEZONE=Asia/Ho_Chi_Minh
ANTHROPIC_API_KEY=dán_key_Anthropic_vào_đây

GEMINI_API_KEY=dán_key_Gemini_vào_đây
GEMINI_MODEL=gemini-3.5-flash-lite
TG_API_ID=số_api_id
TG_API_HASH=chuỗi_api_hash
TG_GROUP_ID=id_nhóm_cần_đọc
TG_GROUP_TITLE=tên_nhóm
RELAY_TARGET=username_người_nhận_không_có_@
MANA_CHECK_TIME=17:31
KT_CHECK_TIME=23:30
THU4_TIME=11:00
THU5_TIME=08:00
AUTOREPLY_TEXT="Xin chào, tôi đang bận."
AUTOREPLY_DELAY_MIN=1
AUTOREPLY_COOLDOWN_H=6
